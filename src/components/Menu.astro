---
import { getTranslations, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="menu" class="sample-menu-section" aria-label="Sample Menu">
  <div class="sample-menu-container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="eyebrow-script">{t.menu.eyebrow}</span>
      <h2 class="section-heading">{t.menu.heading}</h2>
    </div>

    <!-- Short centred line of body text -->
    <p class="menu-subline">{t.menu.line}</p>

    <!-- Two columns of cards: images aspect-ratio: 10 / 7, 3 rows, 56px between rows -->
    <div class="menu-cards-grid">
      {t.menu.cards.map((card) => (
        <article class="menu-card">
          <!-- Card Image: aspect-ratio: 10 / 7, square corners -->
          <div class="menu-card-img-box">
            <img 
              src={card.image} 
              srcset={card.image.includes('/assets/menu/') ? `${card.image.replace('.webp', '-800.webp')} 800w, ${card.image} 1600w` : undefined}
              sizes="(max-width: 767px) 100vw, 400px"
              alt={card.alt}
              class="menu-card-img"
              loading="lazy"
              width="400"
              height="280"
            />
          </div>

          <!-- Title 18px below image (heading font, 25px, centred, 2 lines reserved on desktop) -->
          <h3 class="menu-card-title">{card.title}</h3>

          <!-- Dishes in Ubuntu uppercase, centred, 384px wide -->
          <p class="menu-card-dishes">{card.dishes}</p>
        </article>
      ))}
    </div>

    <!-- Small centred note under the menu grid, in the small body style -->
    {t.menu.note && <p class="menu-illustration-note">{t.menu.note}</p>}

    <!-- One centred outline button: about 46px below, with 60px beneath it -->
    <div class="menu-cta-container">
      <a href="#contact" class="btn-outline">{t.menu.button}</a>
    </div>
  </div>
</section>

<style>
  /* SAMPLE MENU: Background white. No tabs and no prices. */
  .sample-menu-section {
    background-color: var(--white);
    width: 100%;
    padding-bottom: 60px;
    box-sizing: border-box;
  }

  .sample-menu-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 45px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  /* Short centred line of body text */
  .menu-subline {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 14px;
    line-height: 25.2px;
    color: var(--text);
    text-align: center;
    margin-top: 10px;
    margin-bottom: 45px;
    max-width: 700px;
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  /* Two columns of cards: images 400 x 280px (10 / 7), 3 rows, 56px between rows */
  .menu-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 400px);
    column-gap: 130px;
    row-gap: 56px;
    justify-content: center;
    width: 100%;
  }

  .menu-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* aspect-ratio: 10 / 7 and object-fit: cover. All six image boxes same size */
  .menu-card-img-box {
    width: 400px;
    max-width: 100%;
    aspect-ratio: 10 / 7;
    overflow: hidden;
    background-color: var(--page-grey);
    border-radius: 0;
  }

  .menu-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s ease;
  }

  .menu-card:hover .menu-card-img {
    transform: scale(1.04);
  }

  /* Title: 18px below image, heading font, 25px, centred.
     Reserve two lines of height for card titles on desktop so dish lists start at the same height across a row */
  .menu-card-title {
    font-family: var(--font-heading);
    font-size: 25px;
    line-height: 1.28;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--heading);
    font-weight: 400;
    margin-top: 18px;
    margin-bottom: 10px;
    min-height: 2.6em; /* 2 lines reserved */
    display: flex;
    align-items: center;
    justify-content: center;
    text-wrap: balance;
  }

  /* Dishes in Ubuntu uppercase, centred, 384px wide */
  .menu-card-dishes {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 13px;
    line-height: 22px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--text);
    max-width: 384px;
    margin: 0 auto;
    text-align: center;
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  /* Small centred note under the menu grid */
  .menu-illustration-note {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 13px;
    line-height: 1.6;
    color: #6D6E71;
    text-align: center;
    margin-top: 36px;
    margin-bottom: 0;
    font-style: italic;
  }

  /* Button: 46px below, 60px beneath */
  .menu-cta-container {
    margin-top: 46px;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Mobile Layout (< 768px): One column */
  @media (max-width: 767px) {
    .sample-menu-container {
      padding: 0 24px;
    }
    .menu-cards-grid {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
    .menu-card-img-box {
      width: 100%;
      aspect-ratio: 10 / 7;
    }
    .menu-card-title {
      min-height: auto;
      font-size: 22px;
    }
    .menu-card-dishes {
      max-width: 100%;
      font-size: 12px;
      line-height: 20px;
    }
    .menu-cta-container {
      margin-top: 36px;
    }
  }
</style>
