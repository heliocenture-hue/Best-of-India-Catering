---
import { getTranslations, type Language } from '../i18n/utils';
import { CONFIG } from '../config';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const privacyLink = lang === 'fr' ? '/politique-confidentialite/' : '/en/privacy-policy/';
const legalLink = lang === 'fr' ? '/mentions-legales/' : '/en/legal-notice/';
const fullSiteUrl = lang === 'fr' ? 'https://bestofindiaparis.com/' : 'https://bestofindiaparis.com/en/';
---

<footer id="site-footer" class="site-footer">
  <!-- Top Body: Background --footer (#19191A), 250px high on desktop -->
  <div class="footer-main-container">
    <div class="footer-inner">
      <!-- Left: script "Quick Links", two link columns in white Ubuntu bold uppercase -->
      <div class="footer-left-col">
        <span class="footer-script-title">{t.footer.quickLinks}</span>
        <div class="footer-nav-cols">
          <ul class="footer-link-col">
            <li><a href="#top" class="footer-link">{t.footer.home}</a></li>
            <li><a href="#about" class="footer-link">{t.footer.whoWeAre}</a></li>
            <li><a href="#occasions" class="footer-link">{t.footer.ourEvents}</a></li>
            <li><a href="#menu" class="footer-link">{t.footer.ourMenu}</a></li>
          </ul>
          <ul class="footer-link-col">
            <li><a href="#reviews" class="footer-link">{t.footer.reviews}</a></li>
            <li><a href="#why" class="footer-link">{t.footer.whyChooseUs}</a></li>
            <li><a href="#contact" class="footer-link">{t.footer.contact}</a></li>
            <li>
              <a href={fullSiteUrl} target="_blank" rel="noopener noreferrer" class="footer-link">
                {t.footer.fullWebsite}
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Centre: boi-mark.png on a white panel, 111 x 131px -->
      <div class="footer-centre-panel">
        <div class="monogram-white-box">
          <img 
            src="/assets/boi-mark.png" 
            alt="Best of India Monogram" 
            class="monogram-img"
            width="81"
            height="91"
          />
        </div>
      </div>

      <!-- Right: Social icons in white, phone, email, address -->
      <div class="footer-right-col">
        <div class="footer-social-row">
          <a href={CONFIG.INSTAGRAM} target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Instagram">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href={CONFIG.FACEBOOK} target="_blank" rel="noopener noreferrer" class="social-icon-link" aria-label="Facebook">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>

        <div class="footer-contact-details">
          <a href={`tel:${CONFIG.PHONE_LINK}`} class="footer-contact-item">{CONFIG.PHONE_DISPLAY}</a>
          <a href={`mailto:${CONFIG.EMAIL}`} class="footer-contact-item">{CONFIG.EMAIL}</a>
          <span class="footer-contact-item address-item">{CONFIG.ADDRESS}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar: Background --footer-bar (#000000), 48px high -->
  <div class="footer-bottom-bar">
    <div class="bottom-bar-inner">
      <div class="bottom-bar-center">
        <span class="bottom-bar-text">{t.footer.rights}</span>
        <span class="bottom-bar-divider">|</span>
        <a href={privacyLink} class="bottom-bar-link">{t.footer.privacy}</a>
        <span class="bottom-bar-divider">|</span>
        <a href={legalLink} class="bottom-bar-link">{t.footer.legal}</a>
      </div>

      <!-- At far right of bottom row: thin up chevron with "Back to Top" beneath -->
      <a href="#top" class="footer-back-to-top" aria-label="Back to top">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.6">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
        <span class="back-to-top-text">{t.footer.backToTop}</span>
      </a>
    </div>
  </div>
</footer>

<style>
  /* FOOTER: Background --footer, 250px high, then --footer-bar 48px high */
  .site-footer {
    background-color: var(--footer);
    color: var(--white);
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .footer-main-container {
    width: 100%;
    min-height: 250px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 45px;
    box-sizing: border-box;
  }

  .footer-inner {
    max-width: 1200px;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
  }

  /* Left: script "Quick Links", two columns */
  .footer-left-col {
    display: flex;
    flex-direction: column;
  }

  .footer-script-title {
    font-family: var(--font-script);
    font-size: 38px;
    line-height: 1;
    color: var(--white);
    margin-bottom: 14px;
    display: block;
  }

  .footer-nav-cols {
    display: flex;
    gap: 48px;
  }

  .footer-link-col {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--white);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer-link:hover {
    opacity: 0.75;
  }

  /* Centre: boi-mark.png on a white panel, 111 x 131px */
  .footer-centre-panel {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .monogram-white-box {
    width: 111px;
    height: 131px;
    background-color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    box-sizing: border-box;
  }

  .monogram-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* Right: Social icons in white, phone, email, address */
  .footer-right-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .footer-social-row {
    display: flex;
    gap: 16px;
    margin-bottom: 18px;
  }

  .social-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    transition: opacity 0.2s ease;
  }

  .social-icon-link:hover {
    opacity: 0.75;
  }

  .footer-contact-details {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.8px;
  }

  .footer-contact-item {
    color: var(--white);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer-contact-item:hover {
    opacity: 0.75;
  }

  .address-item {
    max-width: 280px;
    line-height: 1.4;
  }

  /* Bottom Bar: 48px high, background --footer-bar (#000000) */
  .footer-bottom-bar {
    width: 100%;
    height: 48px;
    background-color: var(--footer-bar);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 45px;
    box-sizing: border-box;
  }

  .bottom-bar-inner {
    max-width: 1200px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .bottom-bar-center {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--white);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .bottom-bar-divider {
    opacity: 0.5;
  }

  .bottom-bar-link {
    color: var(--white);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .bottom-bar-link:hover {
    opacity: 0.75;
  }

  /* Back to Top at far right */
  .footer-back-to-top {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--white);
    text-decoration: none;
    gap: 2px;
    transition: opacity 0.2s ease;
  }

  .footer-back-to-top:hover {
    opacity: 0.75;
  }

  .back-to-top-text {
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Mobile Layout (< 768px):
     Quick Links and monogram at top, then everything else stacked */
  @media (max-width: 767px) {
    .footer-main-container {
      padding: 40px 20px;
      min-height: auto;
    }
    .footer-inner {
      flex-direction: column;
      align-items: center;
      gap: 32px;
      text-align: center;
    }
    .footer-left-col {
      align-items: center;
    }
    .footer-nav-cols {
      gap: 32px;
    }
    .footer-link-col {
      align-items: center;
    }
    .footer-right-col {
      align-items: center;
      text-align: center;
    }
    .footer-bottom-bar {
      height: auto;
      padding: 16px 20px;
    }
    .bottom-bar-inner {
      flex-direction: column;
      gap: 12px;
    }
    .footer-back-to-top {
      position: static;
      transform: none;
      margin-top: 8px;
    }
  }
</style>
