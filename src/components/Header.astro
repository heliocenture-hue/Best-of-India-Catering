---
import { CONFIG } from '../config';
import type { Language } from '../i18n/utils';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const baseNav = lang === 'en' ? '/en/' : '/';
const targetLang = lang === 'en' ? 'fr' : 'en';
const otherLangHref = lang === 'en' ? '/' : '/en/';

const navLinks = [
  { href: `${baseNav}#about`, label: t.nav.about, id: 'about' },
  { href: `${baseNav}#occasions`, label: t.nav.occasions, id: 'occasions' },
  { href: `${baseNav}#reviews`, label: t.nav.reviews, id: 'reviews' },
  { href: `${baseNav}#menu`, label: t.nav.menu, id: 'menu' },
  { href: `${baseNav}#why`, label: t.nav.why, id: 'why' },
  { href: `${baseNav}#contact`, label: t.nav.contact, id: 'contact' },
];
---

<header class="site-header" id="main-header">
  <div class="container header-container">
    <!-- Logo -->
    <a href={baseNav} class="header-logo" aria-label={`${CONFIG.BRAND} - ${t.hero.h1}`}>
      <img
        src="/assets/boi-logo.png"
        alt="Best of India Restaurant Indien & Traiteur Paris"
        width="180"
        height="54"
        class="logo-img"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link" data-section={link.id}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Language Switch & CTA) -->
    <div class="header-actions">
      <!-- Language Switcher: Visible on desktop and mobile beside hamburger -->
      <div class="lang-switch" role="group" aria-label="Language selection">
        <a
          href={lang === 'fr' ? '#' : '/'}
          class={`lang-btn ${lang === 'fr' ? 'active' : ''}`}
          data-lang="fr"
          aria-current={lang === 'fr' ? 'page' : undefined}
          title="Version Française"
        >
          FR
        </a>
        <span class="lang-divider" aria-hidden="true">|</span>
        <a
          href={lang === 'en' ? '#' : '/en/'}
          class={`lang-btn ${lang === 'en' ? 'active' : ''}`}
          data-lang="en"
          aria-current={lang === 'en' ? 'page' : undefined}
          title="English version"
        >
          EN
        </a>
      </div>

      <!-- Header CTA Button -->
      <a href={`${baseNav}#contact`} class="btn-primary header-cta">
        {t.nav.cta}
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        class="mobile-menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.open_menu}
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Full-Screen Navigation Drawer -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-content">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link" data-mobile-link>
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="mobile-menu-footer">
        <a href={`${baseNav}#contact`} class="btn-primary mobile-cta" data-mobile-link>
          {t.nav.cta}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height-full);
    background-color: var(--color-white);
    z-index: 100;
    transition: height 0.25s ease, box-shadow 0.25s ease;
    border-bottom: 1px solid rgba(74, 36, 18, 0.06);
  }

  .site-header.scrolled {
    height: var(--header-height-scrolled);
    box-shadow: 0 4px 16px rgba(74, 36, 18, 0.08);
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  .site-header.scrolled .logo-img {
    height: 40px;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 992px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
  }

  .nav-link {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-deep-brown);
    position: relative;
    padding: 6px 0;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-saffron-orange);
    transition: width 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-dark-orange);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Language Switch */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    background-color: var(--color-warm-cream);
    border: 1px solid rgba(74, 36, 18, 0.1);
  }

  .lang-btn {
    color: var(--color-grey);
    transition: color 0.2s ease;
    padding: 2px 4px;
    border-radius: 4px;
  }

  .lang-btn:hover {
    color: var(--color-dark-orange);
  }

  .lang-btn.active {
    color: var(--color-deep-brown);
    background-color: rgba(242, 140, 30, 0.2);
  }

  .lang-divider {
    color: rgba(74, 36, 18, 0.2);
    font-weight: 400;
  }

  .header-cta {
    display: none;
    padding: 10px 20px;
    font-size: 14px;
    min-height: 42px;
  }

  @media (min-width: 768px) {
    .header-cta {
      display: inline-flex;
    }
  }

  /* Mobile Toggle */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 8px;
    border-radius: var(--radius-sm);
  }

  @media (min-width: 992px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .hamburger-bar {
    width: 22px;
    height: 2px;
    background-color: var(--color-deep-brown);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .mobile-menu-toggle.open .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-toggle.open .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.open .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-menu {
    position: fixed;
    top: var(--header-height-full);
    left: 0;
    width: 100%;
    height: calc(100vh - var(--header-height-full));
    background-color: var(--color-white);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    z-index: 99;
  }

  .site-header.scrolled .mobile-menu {
    top: var(--header-height-scrolled);
    height: calc(100vh - var(--header-height-scrolled));
  }

  .mobile-menu.active {
    transform: translateX(0);
  }

  .mobile-menu-content {
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mobile-nav-link {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-deep-brown);
    display: block;
    padding: 10px 0;
    border-bottom: 1px solid rgba(74, 36, 18, 0.06);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--color-dark-orange);
  }

  .mobile-menu-footer {
    padding-top: 32px;
  }

  .mobile-cta {
    width: 100%;
  }
</style>

<script>
  // Shrink header on scroll
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Mobile menu toggle
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');

  function toggleMenu() {
    const isOpen = mobileMenu?.classList.toggle('active');
    toggleBtn?.classList.toggle('open');
    toggleBtn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    mobileMenu?.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  toggleBtn?.addEventListener('click', toggleMenu);
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (mobileMenu?.classList.contains('active')) {
        toggleMenu();
      }
    });
  });

  // Highlight active section on scroll
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        navLinks.forEach((link) => {
          if (link.getAttribute('data-section') === id) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    });
  }, { rootMargin: '-20% 0px -70% 0px' });

  sections.forEach((sec) => observer.observe(sec));

  // Language switch: preserve anchor & save preference
  const langButtons = document.querySelectorAll('.lang-btn');
  langButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = btn.getAttribute('data-lang');
      try {
        localStorage.setItem('boi_preferred_lang', target || 'fr');
      } catch (err) {
        // storage disabled
      }
      const hash = window.location.hash;
      const targetBase = target === 'en' ? '/en/' : '/';
      window.location.href = targetBase + hash;
      e.preventDefault();
    });
  });
</script>
