---
import { getTranslations, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="why" class="why-us-section" aria-label="Why Choose Best of India">
  <div class="why-us-container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="eyebrow-script">{t.why.eyebrow}</span>
      <h2 class="section-heading">{t.why.heading}</h2>
    </div>

    <!-- 3 columns x 2 rows, each column 330px wide with 60px gaps, same grid as tiles -->
    <div class="why-us-grid">
      {t.why.items.map((item) => (
        <div class="why-us-item">
          <!-- Title in heading font in rust at 25px, centred -->
          <h3 class="why-item-title">{item.title}</h3>
          <!-- Short rule -->
          <hr class="why-item-rule short-rule" />
          <!-- Body text centred -->
          <p class="why-item-desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* WHY CHOOSE US: Background --page-grey. No icons and no boxes. Add 72px of space beneath. */
  .why-us-section {
    background-color: var(--page-grey);
    width: 100%;
    padding-bottom: 72px;
    box-sizing: border-box;
  }

  .why-us-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 45px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  /* 3 columns x 2 rows, each column 330px wide with 60px gaps */
  .why-us-grid {
    display: grid;
    grid-template-columns: repeat(3, 330px);
    gap: 60px;
    justify-content: center;
    margin-top: 36px;
    width: 100%;
  }

  .why-us-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Title in heading font in rust at 25px */
  .why-item-title {
    font-family: var(--font-heading);
    font-size: 25px;
    line-height: 32px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 400;
    margin: 0;
  }

  .why-item-rule {
    width: 184px;
    height: 1px;
    background-color: var(--accent);
    border: none;
    margin: 16px auto 14px auto;
  }

  /* Body text centred */
  .why-item-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 14px;
    line-height: 25.2px;
    color: var(--text);
    text-align: center;
    margin: 0;
  }

  /* Tablet: 2 columns */
  @media (min-width: 768px) and (max-width: 1199px) {
    .why-us-grid {
      grid-template-columns: repeat(2, 330px);
      gap: 40px;
    }
  }

  /* Mobile Layout (< 768px): One column */
  @media (max-width: 767px) {
    .why-us-container {
      padding: 0 24px;
    }
    .why-us-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-top: 24px;
    }
    .why-item-desc {
      font-size: 15px;
      line-height: 24px;
    }
  }
</style>
