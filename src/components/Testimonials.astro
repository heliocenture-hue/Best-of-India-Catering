---
import { getTranslations, type Language } from '../i18n/utils';
import rawReviews from '../data/testimonials.json';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// Check for unfilled entries and issue a build warning
const unfilledCount = rawReviews.filter(r => !r.verified || !r.quote_en || !r.name).length;
if (unfilledCount > 0) {
  console.warn(`[BOI CATERING BUILD WARNING]: ${unfilledCount} of ${rawReviews.length} client reviews in src/data/testimonials.json are unverified/placeholder entries.`);
}

// Map reviews to current language with placeholder fallback
const reviews = rawReviews.map((r) => {
  const isVerified = r.verified === true;
  const quote = isVerified
    ? (lang === 'fr' ? (r.quote_fr || r.quote_en) : r.quote_en)
    : t.reviews.placeholderQuote;
  const author = isVerified && r.name ? r.name : t.reviews.placeholderName;

  return { quote, author };
});
---

<section id="reviews" class="reviews-section" aria-label="Customer Reviews">
  <div class="reviews-container">
    <!-- Centred Section Header -->
    <h2 class="reviews-heading">{t.reviews.heading}</h2>

    <!-- Intro Text: 681px wide -->
    <p class="reviews-intro">{t.reviews.intro}</p>

    <!-- Carousel Container -->
    <div class="reviews-carousel-wrapper" id="reviews-carousel">
      <!-- Large Tan Quotation Mark behind text (100 x 100px, color --quote-mark) -->
      <div class="quote-mark" aria-hidden="true">“</div>

      <!-- Left chevron arrow: 50 x 50px -->
      <button class="review-nav-btn prev-btn" id="review-prev-btn" aria-label={t.reviews.prevAria}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Review Slides -->
      <div class="review-slides">
        {reviews.map((item, idx) => (
          <div 
            class={`review-slide ${idx === 0 ? 'is-active' : ''}`}
            data-index={idx}
          >
            <!-- Review text 790px wide in Ubuntu uppercase -->
            <blockquote class="review-quote-text">
              {item.quote}
            </blockquote>
            <!-- Client name in script about 40px below the review -->
            <cite class="review-client-name">
              {item.author}
            </cite>
          </div>
        ))}
      </div>

      <!-- Right chevron arrow: 50 x 50px -->
      <button class="review-nav-btn next-btn" id="review-next-btn" aria-label={t.reviews.nextAria}>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  /* REVIEWS: Background --panel, minimum height 480px. Everything is centred. */
  .reviews-section {
    background-color: var(--panel);
    min-height: 480px;
    width: 100%;
    padding: 66px 20px 60px 20px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .reviews-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  /* Heading: Italiana, uppercase, centred */
  .reviews-heading {
    font-family: var(--font-heading);
    font-size: 35px;
    line-height: 42px;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: var(--heading);
    font-weight: 400;
    margin: 0 0 16px 0;
  }

  /* Intro text: 681px wide */
  .reviews-intro {
    max-width: 681px;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 14px;
    line-height: 25.2px;
    color: var(--text);
    margin: 0 auto 36px auto;
  }

  /* Carousel Wrapper */
  .reviews-carousel-wrapper {
    position: relative;
    width: 100%;
    max-width: 1080px;
    min-height: 230px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Large tan quotation mark: 100 x 100px behind text */
  .quote-mark {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-heading);
    font-size: 140px;
    line-height: 1;
    color: var(--quote-mark);
    opacity: 0.45;
    pointer-events: none;
    z-index: 1;
    user-select: none;
  }

  /* Chevron Buttons: 50 x 50px */
  .review-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    background: transparent;
    border: none;
    color: var(--accent);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: opacity 0.2s ease, transform 0.2s ease;
    padding: 0;
  }

  .review-nav-btn:hover {
    opacity: 0.7;
  }

  .prev-btn {
    left: 20px;
  }

  .next-btn {
    right: 20px;
  }

  /* Review Slides: Crossfade 6s */
  .review-slides {
    position: relative;
    width: 100%;
    max-width: 790px;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .review-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease-in-out, visibility 0.8s ease-in-out;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .review-slide.is-active {
    opacity: 1;
    visibility: visible;
    position: relative;
  }

  /* Review text: 790px wide in Ubuntu uppercase */
  .review-quote-text {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 14px;
    line-height: 25.2px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--text);
    margin: 0;
    font-style: normal;
  }

  /* Client name in script about 40px below review */
  .review-client-name {
    font-family: var(--font-script);
    font-size: 44px;
    line-height: 1;
    color: var(--accent);
    margin-top: 36px;
    display: block;
    font-style: normal;
  }

  /* Mobile Layout (< 768px):
     - Heading, intro, large centred quotation mark, review text, script name,
       with arrows at the left and right edges. */
  @media (max-width: 767px) {
    .reviews-section {
      padding: 48px 16px 40px 16px;
      min-height: auto;
    }
    .reviews-heading {
      font-size: 26px;
      line-height: 32px;
      letter-spacing: 2px;
    }
    .reviews-intro {
      font-size: 15px;
      line-height: 24px;
      margin-bottom: 24px;
    }
    .reviews-carousel-wrapper {
      padding: 0 44px;
      box-sizing: border-box;
    }
    .prev-btn {
      left: -6px;
    }
    .next-btn {
      right: -6px;
    }
    .review-quote-text {
      font-size: 13px;
      line-height: 22px;
    }
    .review-client-name {
      font-size: 36px;
      margin-top: 24px;
    }
  }
</style>

<script>
  function setupReviewsCarousel() {
    const wrapper = document.getElementById('reviews-carousel');
    if (!wrapper) return;

    const slides = wrapper.querySelectorAll<HTMLElement>('.review-slide');
    const prevBtn = document.getElementById('review-prev-btn');
    const nextBtn = document.getElementById('review-next-btn');
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: number | null = null;
    const intervalDuration = 6000;

    function goToSlide(index: number) {
      slides[currentIndex].classList.remove('is-active');
      currentIndex = (index + slides.length) % slides.length;
      slides[currentIndex].classList.add('is-active');
    }

    function startTimer() {
      if (timer) clearInterval(timer);
      timer = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, intervalDuration);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    prevBtn?.addEventListener('click', () => {
      stopTimer();
      goToSlide(currentIndex - 1);
      startTimer();
    });

    nextBtn?.addEventListener('click', () => {
      stopTimer();
      goToSlide(currentIndex + 1);
      startTimer();
    });

    // Pause on hover
    wrapper.addEventListener('mouseenter', stopTimer);
    wrapper.addEventListener('mouseleave', startTimer);

    // Initial start
    startTimer();
  }

  setupReviewsCarousel();
  document.addEventListener('astro:page-load', setupReviewsCarousel);
</script>
