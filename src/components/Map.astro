---
import { CONFIG } from '../config';

interface Props {
  lang: 'fr' | 'en';
}

const { lang } = Astro.props;
const title = lang === 'fr' 
  ? "Localisation du restaurant Best of India à Paris 10ème sur Google Maps"
  : "Best of India restaurant location in Paris 10th on Google Maps";
---

<section id="location-map" class="map-section" aria-label="Restaurant Location">
  <iframe
    src={CONFIG.MAP_EMBED}
    class="map-iframe"
    width="100%"
    height="420"
    style="border:0;"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={title}
  ></iframe>
</section>

<style>
  /* MAP: Full-width iframe of MAP_EMBED, 420px high, directly below contact section with NO GAP */
  .map-section {
    width: 100%;
    height: 420px;
    margin: 0;
    padding: 0;
    line-height: 0;
    background-color: #EFE3D0;
  }

  .map-iframe {
    width: 100%;
    height: 420px;
    display: block;
    border: none;
    filter: saturate(0.9) contrast(1.05);
  }

  @media (max-width: 767px) {
    .map-section,
    .map-iframe {
      height: 320px;
    }
  }
</style>

