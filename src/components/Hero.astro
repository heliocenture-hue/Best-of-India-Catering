---
import { getTranslations, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// 5 real BOI food photos
const slides = [
  { src: '/assets/images/boi/hero-1.webp', alt: `${t.hero.altPrefix} 1` },
  { src: '/assets/images/boi/hero-2.webp', alt: `${t.hero.altPrefix} 2` },
  { src: '/assets/images/boi/hero-3.webp', alt: `${t.hero.altPrefix} 3` },
  { src: '/assets/images/boi/hero-4.webp', alt: `${t.hero.altPrefix} 4` },
  { src: '/assets/images/boi/about-1.webp', alt: `${t.hero.altPrefix} 5` }
];
---

<section id="hero-slider" class="hero-section" aria-label="Best of India Catering Showcase">
  <div class="hero-slides-wrapper">
    {slides.map((slide, idx) => (
      <div 
        class={`hero-slide ${idx === 0 ? 'is-active' : ''}`}
        data-slide-index={idx}
      >
        <img 
          src={slide.src} 
          alt={slide.alt}
          class="hero-img"
          loading={idx === 0 ? 'eager' : 'lazy'}
          fetchpriority={idx === 0 ? 'high' : 'auto'}
          width="1440"
          height="680"
        />
      </div>
    ))}
  </div>
</section>

<style>
  /* Hero: Full-width image slider, 680px high, starting at the very top of the page.
     Show 5 real BOI food photos, using object-fit: cover. Crossfade every 5 seconds.
     No text, overlay, arrows or dots. Pause it for prefers-reduced-motion. */
  .hero-section {
    position: relative;
    width: 100%;
    height: 680px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #19191A;
  }

  .hero-slides-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.2s ease-in-out, visibility 1.2s ease-in-out;
  }

  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Mobile: full width, 287px high */
  @media (max-width: 767px) {
    .hero-section {
      height: 287px;
    }
  }
</style>

<script>
  function setupHeroSlider() {
    const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
    if (slides.length <= 1) return;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    let currentIndex = 0;
    let intervalId: number | null = null;

    function nextSlide() {
      slides[currentIndex].classList.remove('is-active');
      currentIndex = (currentIndex + 1) % slides.length;
      slides[currentIndex].classList.add('is-active');
    }

    intervalId = window.setInterval(nextSlide, 5000);

    // Pause on page hidden
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && intervalId !== null) {
        clearInterval(intervalId);
      } else if (!document.hidden && !prefersReducedMotion) {
        intervalId = window.setInterval(nextSlide, 5000);
      }
    });
  }

  setupHeroSlider();
  document.addEventListener('astro:page-load', setupHeroSlider);
</script>
