---
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<section id="hero-media" class="hero-section" aria-label="Best of India Catering Video Showcase">
  <video
    id="hero-video"
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
  >
  </video>
</section>

<style>
  /* Hero: Full-width background video, 680px desktop, 287px mobile.
     object-fit: cover, object-position: center, filling hero edge to edge.
     No black bars, overlay, controls or sound. */
  .hero-section {
    position: relative;
    width: 100%;
    height: 680px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: #19191A;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border: none;
    outline: none;
    background-color: #19191A;
  }

  /* Mobile: 287px high */
  @media (max-width: 767px) {
    .hero-section {
      height: 287px;
    }
  }
</style>

<script>
  function initHeroVideo() {
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    const heroSection = document.getElementById('hero-media');
    if (!video || !heroSection) return;

    const isMobile = window.innerWidth < 768;
    const desktopVideo = '/assets/video/hero-desktop.mp4';
    const mobileVideo = '/assets/video/hero-mobile.mp4';
    const desktopPoster = '/assets/video/hero-poster-desktop.jpg';
    const mobilePoster = '/assets/video/hero-poster-mobile.jpg';

    // Set poster immediately based on viewport
    video.poster = isMobile ? mobilePoster : desktopPoster;

    // Check prefers-reduced-motion and Save-Data
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const navAny = navigator as any;
    const saveData = Boolean(navAny.connection && navAny.connection.saveData === true);

    // If reduced motion or Save-Data is active, do not load or play video (show poster only)
    if (prefersReducedMotion || saveData) {
      return;
    }

    function loadAndPlay() {
      // Pick source before loading so only ONE video file downloads
      const chosenSource = isMobile ? mobileVideo : desktopVideo;
      video.src = chosenSource;

      // Autoplay attempt
      video.play().catch(() => {
        // If autoplay blocked, poster remains visible
      });

      // Pause when off screen, resume when returns
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                if (video.paused && video.src) {
                  video.play().catch(() => {});
                }
              } else {
                if (!video.paused) {
                  video.pause();
                }
              }
            });
          },
          { threshold: 0.1 }
        );

        observer.observe(heroSection);
      }
    }

    // Start loading video after window load event so it does not slow first paint
    if (document.readyState === 'complete') {
      loadAndPlay();
    } else {
      window.addEventListener('load', loadAndPlay, { once: true });
    }
  }

  initHeroVideo();
  document.addEventListener('astro:page-load', initHeroVideo);
</script>
