---
import { getTranslations, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="occasions" class="who-we-serve-section">
  <div class="who-we-serve-container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="eyebrow-script">{t.occasions.eyebrow}</span>
      <h2 class="section-heading">{t.occasions.heading}</h2>
    </div>

    <!-- Grid of 330 x 330px square tiles in 3 columns, 60px apart, 60px between rows -->
    <div class="occasions-grid">
      {t.occasions.items.map((item) => (
        <a 
          href="#contact" 
          class="occasion-tile"
          data-event-id={item.id}
          aria-label={`${item.title} - ${t.occasions.tileAction}`}
        >
          <!-- Background Photo: opacity 0.25 resting, 1.0 on hover -->
          <div class="tile-photo-wrapper">
            <img 
              src={item.image} 
              alt={item.alt}
              class="tile-photo"
              loading="lazy"
              width="330"
              height="330"
            />
          </div>

          <!-- Resting Content: Title in rust, short rule, "Get a Quote" -->
          <div class="tile-content">
            <h3 class="tile-title">{item.title}</h3>
            <hr class="tile-rule" />
            <span class="tile-action">{t.occasions.tileAction}</span>
          </div>

          <!-- Mobile Text Container (rendered below the photo on mobile) -->
          <div class="tile-mobile-meta">
            <h3 class="tile-mobile-title">{item.title}</h3>
            <span class="tile-mobile-action">{t.occasions.tileAction}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- One centred outline button, 58px below grid, ~60px beneath -->
    <div class="occasions-footer-action">
      <a href="#contact" class="btn-outline">{t.occasions.button}</a>
    </div>
  </div>
</section>

<style>
  .who-we-serve-section {
    background-color: var(--white);
    width: 100%;
    padding-bottom: 60px;
    box-sizing: border-box;
  }

  .who-we-serve-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 45px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  /* Grid: 3 columns x 3 rows of 330x330px, 60px gaps */
  .occasions-grid {
    display: grid;
    grid-template-columns: repeat(3, 330px);
    gap: 60px;
    justify-content: center;
    margin-top: 36px;
    width: 100%;
  }

  /* Tile: Exactly like Ruby's venue tile
     Square 330 x 330px, square corners, white background */
  .occasion-tile {
    position: relative;
    width: 330px;
    height: 330px;
    background-color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
  }

  .tile-photo-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: var(--white);
    overflow: hidden;
  }

  /* Resting: opacity 0.25 on white. Hover: opacity 1 over 0.5s */
  .tile-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
    transition: opacity 0.5s ease;
  }

  .occasion-tile:hover .tile-photo {
    opacity: 1;
  }

  /* Centered content: Title, short rule 18px below, action label */
  .tile-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    transition: opacity 0.5s ease;
  }

  /* On hover, all text fades out over 0.5s */
  .occasion-tile:hover .tile-content {
    opacity: 0;
  }

  .tile-title {
    font-family: var(--font-heading);
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 400;
    margin: 0;
  }

  .tile-rule {
    width: 184px;
    height: 1px;
    background-color: var(--accent);
    border: none;
    margin: 18px auto 14px auto;
  }

  .tile-action {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tile-mobile-meta {
    display: none;
  }

  .occasions-footer-action {
    margin-top: 58px;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Tablet: 2 columns */
  @media (min-width: 768px) and (max-width: 1199px) {
    .occasions-grid {
      grid-template-columns: repeat(2, 330px);
      gap: 40px;
    }
  }

  /* Mobile Layout (< 768px):
     - one column, photo square at full opacity with 33px side margins,
     - title below it in black, then the label below that.
     - No washed-out overlay on mobile. */
  @media (max-width: 767px) {
    .who-we-serve-container {
      padding: 0 33px;
    }
    .occasions-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-top: 24px;
    }
    .occasion-tile {
      width: 100%;
      height: auto;
      flex-direction: column;
      overflow: visible;
      background: transparent;
    }
    .tile-photo-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      height: auto;
    }
    .tile-photo {
      opacity: 1 !important;
    }
    .tile-content {
      display: none; /* Hide overlay content on mobile */
    }
    .tile-mobile-meta {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-top: 14px;
      gap: 6px;
    }
    .tile-mobile-title {
      font-family: var(--font-heading);
      font-size: 24px;
      line-height: 1.2;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--heading); /* In black */
      font-weight: 400;
      margin: 0;
    }
    .tile-mobile-action {
      font-family: var(--font-ui);
      font-weight: 500;
      font-size: 13px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--accent); /* Rust label */
    }
    .occasions-footer-action {
      margin-top: 40px;
    }
  }
</style>

<script>
  // Pre-select occasion in contact form when a tile is clicked
  function setupOccasionTileClick() {
    const tiles = document.querySelectorAll<HTMLElement>('.occasion-tile');
    tiles.forEach((tile) => {
      tile.addEventListener('click', () => {
        const eventId = tile.dataset.eventId;
        if (eventId) {
          const selectEl = document.getElementById('event-type-select') as HTMLSelectElement | null;
          if (selectEl) {
            selectEl.value = eventId;
          }
          // dataLayer event
          try {
            (window as any).dataLayer = (window as any).dataLayer || [];
            (window as any).dataLayer.push({
              event: 'click_occasion_tile',
              occasion_id: eventId
            });
          } catch (_) {}
        }
      });
    });
  }

  setupOccasionTileClick();
  document.addEventListener('astro:page-load', setupOccasionTileClick);
</script>
