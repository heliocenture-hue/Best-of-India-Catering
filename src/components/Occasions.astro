---
import type { Language } from '../i18n/utils';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const baseNav = lang === 'en' ? '/en/' : '/';
---

<section class="occasions-section" id="occasions">
  <div class="container">
    <div class="section-header text-center">
      <span class="eyebrow">{t.occasions.eyebrow}</span>
      <h2 class="section-h2">{t.occasions.h2}</h2>
      <p class="section-subtitle mx-auto">{t.occasions.text}</p>
    </div>

    <!-- 8 Cards: 4x2 desktop, 2 col tablet, 1 col mobile -->
    <div class="occasions-grid">
      {t.occasions.cards.map((card) => (
        <a
          href={`${baseNav}#contact`}
          class="occasion-card hover-zoom-wrapper"
          data-event-id={card.id}
          data-event-title={card.title}
        >
          <div class="card-media">
            <img
              src={card.image}
              alt={card.image_alt}
              width="400"
              height="300"
              class="card-img hover-zoom-img"
              loading="lazy"
            />
          </div>
          <div class="card-body">
            <h3 class="card-title">{card.title}</h3>
            <p class="card-text">{card.text}</p>
            <span class="card-link">
              <span>{t.occasions.cta_card}</span>
              <svg class="arrow-icon" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1 0 1.414l-4 4a1 1 0 0 1-1.414-1.414L14.586 11H3a1 1 0 1 1 0-2h11.586l-2.293-2.293a1 1 0 0 1 0-1.414z" clip-rule="evenodd"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom prompt -->
    <div class="occasions-bottom text-center">
      <p class="bottom-prompt-text">{t.occasions.bottom_text}</p>
      <a href={`${baseNav}#contact`} class="btn-secondary" data-track="occasions_contact_custom">
        {t.occasions.bottom_button}
      </a>
    </div>
  </div>
</section>

<style>
  .occasions-section {
    background-color: var(--color-warm-cream);
    padding-top: 80px;
    padding-bottom: 90px;
  }

  @media (min-width: 992px) {
    .occasions-section {
      padding-top: 100px;
      padding-bottom: 110px;
    }
  }

  .text-center {
    text-align: center;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  .occasions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 40px;
    margin-bottom: 48px;
  }

  @media (min-width: 640px) {
    .occasions-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (min-width: 1024px) {
    .occasions-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  .occasion-card {
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(74, 36, 18, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
  }

  .occasion-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(242, 140, 30, 0.4);
  }

  .card-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: rgba(74, 36, 18, 0.05);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-deep-brown);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .card-text {
    font-size: 14px;
    color: var(--color-grey);
    line-height: 1.5;
    margin-bottom: 18px;
    flex-grow: 1;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-dark-orange);
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .occasion-card:hover .card-link {
    color: var(--color-saffron-orange);
    gap: 10px;
  }

  .arrow-icon {
    transition: transform 0.2s ease;
  }

  .occasion-card:hover .arrow-icon {
    transform: translateX(3px);
  }

  .occasions-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .bottom-prompt-text {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-deep-brown);
  }
</style>

<script>
  // When an occasion card is clicked, scroll to contact form and preselect dropdown
  const cards = document.querySelectorAll('.occasion-card');
  cards.forEach((card) => {
    card.addEventListener('click', (e) => {
      const eventId = card.getAttribute('data-event-id');
      const select = document.getElementById('form-event-type') as HTMLSelectElement | null;
      if (select && eventId) {
        select.value = eventId;
      }

      // Track dataLayer event
      if (typeof window !== 'undefined' && (window as any).dataLayer) {
        (window as any).dataLayer.push({
          event: 'click_occasion_card',
          occasion_id: eventId,
          occasion_title: card.getAttribute('data-event-title')
        });
      }
    });
  });
</script>
