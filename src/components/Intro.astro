---
import { getTranslations, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section id="about" class="who-we-are-section">
  <div class="who-we-are-container">
    <!-- Section Header: eyebrow starts ~76px from top, heading starts ~129px, eyebrow overlaps heading -->
    <div class="section-header">
      <span class="eyebrow-script">{t.about.eyebrow}</span>
      <h2 class="section-heading">{t.about.heading}</h2>
    </div>

    <!-- Body: 840px wide centred starting at y=255 -->
    <div class="about-body-prose body-prose">
      <p>{t.about.paragraph1}</p>
      <p>{t.about.paragraph2}</p>
      <p>{t.about.paragraph3}</p>
    </div>

    <!-- Two outline buttons side by side, 46px apart, 42px below body, with about 52px beneath -->
    <div class="about-actions">
      <a href="#occasions" class="btn-outline">{t.about.buttonEvents}</a>
      <a href="#menu" class="btn-outline">{t.about.buttonMenu}</a>
    </div>
  </div>
</section>

<style>
  .who-we-are-section {
    background-color: var(--page-grey);
    min-height: 643px;
    width: 100%;
    padding-bottom: 52px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }

  .who-we-are-container {
    width: 100%;
    max-width: 840px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about-body-prose {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 32px;
  }

  .about-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 46px;
    margin-top: 42px;
    width: 100%;
  }

  /* Mobile Layout (< 768px):
     Stacked buttons, 24px side margins */
  @media (max-width: 767px) {
    .who-we-are-section {
      min-height: auto;
      padding-bottom: 48px;
    }
    .who-we-are-container {
      padding: 0 24px;
    }
    .about-actions {
      flex-direction: column;
      gap: 16px;
      margin-top: 32px;
    }
  }
</style>
