---
import type { Language } from '../i18n/utils';
import { getTranslations } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const baseNav = lang === 'en' ? '/en/' : '/';
---

<section class="about-section" id="about">
  <div class="container about-container">
    <!-- Left Column on Desktop: Two Overlapping Real BOI Food Photos -->
    <div class="about-images" aria-hidden="true">
      <div class="img-wrapper main-img-wrapper hover-zoom-wrapper">
        <img
          src="/assets/images/boi/about-1.webp"
          alt={t.about.image_alts.img1}
          width="500"
          height="620"
          class="about-img hover-zoom-img"
          loading="lazy"
        />
      </div>
      <div class="img-wrapper secondary-img-wrapper hover-zoom-wrapper">
        <img
          src="/assets/images/boi/about-2.webp"
          alt={t.about.image_alts.img2}
          width="400"
          height="500"
          class="about-img hover-zoom-img"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Right Column on Desktop / First on Mobile: Editorial Copy & Button -->
    <div class="about-content">
      <!-- Subtle dome divider above section title -->
      <div class="dome-divider-wrap" aria-hidden="true">
        <svg viewBox="0 0 40 20" class="dome-svg" width="36" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 18 C4 8, 14 2, 20 2 C26 2, 36 8, 36 18" stroke-linecap="round"/>
          <line x1="20" y1="2" x2="20" y2="0"/>
        </svg>
      </div>

      <span class="eyebrow">{t.about.eyebrow}</span>
      <h2 class="section-h2">{t.about.h2}</h2>

      <div class="about-body">
        <p>{t.about.p1}</p>
        <p>{t.about.p2}</p>
        <p class="highlight-p">{t.about.p3}</p>
      </div>

      <div class="about-action">
        <a href={`${baseNav}#contact`} class="btn-primary" data-track="about_cta">
          {t.about.button}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding-top: 80px;
    padding-bottom: 80px;
    background-color: var(--color-white);
  }

  @media (min-width: 992px) {
    .about-section {
      padding-top: 110px;
      padding-bottom: 110px;
    }
  }

  .about-container {
    display: flex;
    flex-direction: column-reverse; /* text first on mobile */
    gap: 48px;
  }

  @media (min-width: 992px) {
    .about-container {
      display: grid;
      grid-template-columns: 48% 52%;
      align-items: center;
      gap: 60px;
    }
  }

  /* Two Overlapping Images */
  .about-images {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    height: 440px;
  }

  @media (min-width: 768px) {
    .about-images {
      height: 520px;
    }
  }

  .img-wrapper {
    position: absolute;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-hover);
    background-color: var(--color-warm-cream);
  }

  .main-img-wrapper {
    top: 0;
    left: 0;
    width: 75%;
    height: 80%;
    z-index: 1;
  }

  .secondary-img-wrapper {
    bottom: 0;
    right: 0;
    width: 65%;
    height: 70%;
    z-index: 2;
    border: 6px solid var(--color-white);
  }

  .about-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Copy */
  .about-content {
    display: flex;
    flex-direction: column;
  }

  .dome-divider-wrap {
    margin-bottom: 12px;
    color: var(--color-saffron-orange);
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    color: var(--color-grey);
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  @media (min-width: 768px) {
    .about-body {
      font-size: 17px;
    }
  }

  .highlight-p {
    font-weight: 600;
    color: var(--color-deep-brown);
  }

  .about-action {
    display: flex;
  }
</style>
