---
import { getTranslations, type Language } from '../i18n/utils';
import { CONFIG } from '../config';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const privacyLink = lang === 'fr' ? '/politique-confidentialite/' : '/en/privacy-policy/';
const whatsappUrl = `https://wa.me/${CONFIG.WHATSAPP_NUMBER}?text=${encodeURIComponent(t.floating.whatsappMessage)}`;
---

<section id="contact" class="contact-section" aria-label="Contact Best of India">
  <div class="contact-container">
    <!-- Left Column: Heading left-aligned, body text, contact details text links -->
    <div class="contact-info-col">
      <h2 class="contact-heading">{t.contact.heading}</h2>
      <p class="contact-subtext">{t.contact.text}</p>

      <div class="contact-details-list">
        <div class="contact-detail-row">
          <span class="detail-label">{t.contact.phoneLabel}:</span>
          <a href={`tel:${CONFIG.PHONE_LINK}`} class="detail-link">{CONFIG.PHONE_DISPLAY}</a>
        </div>

        <div class="contact-detail-row">
          <span class="detail-label">{t.contact.emailLabel}:</span>
          <a href={`mailto:${CONFIG.EMAIL}`} class="detail-link">{CONFIG.EMAIL}</a>
        </div>

        <div class="contact-detail-row">
          <span class="detail-label">WhatsApp:</span>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="detail-link">{CONFIG.PHONE_DISPLAY}</a>
        </div>

        <div class="contact-detail-row">
          <span class="detail-label">{t.contact.addressLabel}:</span>
          <span class="detail-text">{CONFIG.ADDRESS}</span>
        </div>

        <div class="contact-detail-row">
          <span class="detail-label">{t.contact.hoursLabel}:</span>
          <span class="detail-text">{lang === 'fr' ? CONFIG.HOURS_FR : CONFIG.HOURS_EN}</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Form fields with transparent backgrounds, no boxes, 1px rust bottom border -->
    <div class="contact-form-col">
      <form 
        id="catering-contact-form" 
        class="catering-form" 
        action={CONFIG.FORM_ENDPOINT} 
        method="POST" 
        novalidate
      >
        <!-- Hidden Tracking Fields -->
        <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
        <input type="hidden" name="language" value={lang} />
        <input type="hidden" name="chosen_tile" id="hidden-chosen-tile" value="" />
        <input type="hidden" name="utm_source" id="utm_source" value="" />
        <input type="hidden" name="utm_medium" id="utm_medium" value="" />
        <input type="hidden" name="utm_campaign" id="utm_campaign" value="" />
        <input type="hidden" name="gclid" id="gclid" value="" />

        <!-- Honeypot anti-spam field -->
        <div class="hp-field" style="display:none !important;" aria-hidden="true">
          <label for="company_extra">Do not fill this</label>
          <input type="text" name="company_extra" id="company_extra" tabindex="-1" autocomplete="off" />
        </div>

        <!-- Name Field -->
        <div class="form-group">
          <label for="field-name" class="sr-only">{t.contact.fields.name}</label>
          <input 
            type="text" 
            id="field-name" 
            name="name" 
            class="form-input" 
            placeholder={t.contact.fields.name} 
            required 
          />
          <span class="error-msg" id="err-name">{t.contact.validation.nameRequired}</span>
        </div>

        <!-- Phone Field -->
        <div class="form-group">
          <label for="field-phone" class="sr-only">{t.contact.fields.phone}</label>
          <input 
            type="tel" 
            id="field-phone" 
            name="phone" 
            class="form-input" 
            placeholder={t.contact.fields.phone} 
            required 
          />
          <span class="error-msg" id="err-phone">{t.contact.validation.phoneRequired}</span>
        </div>

        <!-- Email Field -->
        <div class="form-group">
          <label for="field-email" class="sr-only">{t.contact.fields.email}</label>
          <input 
            type="email" 
            id="field-email" 
            name="email" 
            class="form-input" 
            placeholder={t.contact.fields.email} 
            required 
          />
          <span class="error-msg" id="err-email">{t.contact.validation.emailRequired}</span>
        </div>

        <!-- Event Type Field -->
        <div class="form-group">
          <label for="event-type-select" class="sr-only">{t.contact.fields.eventType}</label>
          <select id="event-type-select" name="event_type" class="form-input form-select" required>
            <option value="" disabled selected>{t.contact.fields.eventType}</option>
            {t.occasions.items.map((occ) => (
              <option value={occ.id}>{occ.title}</option>
            ))}
            <option value="other">{t.contact.otherEvent}</option>
          </select>
          <span class="error-msg" id="err-event-type">{t.contact.validation.eventTypeRequired}</span>
        </div>

        <!-- Event Date Field -->
        <div class="form-group">
          <label for="field-date" class="sr-only">{t.contact.fields.eventDate}</label>
          <input 
            type="date" 
            id="field-date" 
            name="event_date" 
            class="form-input form-date" 
            placeholder={t.contact.fields.eventDate} 
          />
        </div>

        <!-- Number of Guests Field -->
        <div class="form-group">
          <label for="field-guests" class="sr-only">{t.contact.fields.guests}</label>
          <select id="field-guests" name="guests_count" class="form-input form-select" required>
            <option value="" disabled selected>{t.contact.fields.guests}</option>
            {t.contact.guestOptions.map((opt) => (
              <option value={opt}>{opt}</option>
            ))}
          </select>
          <span class="error-msg" id="err-guests">{t.contact.validation.guestsRequired}</span>
        </div>

        <!-- Message Field (73px high) -->
        <div class="form-group message-group">
          <label for="field-message" class="sr-only">{t.contact.fields.message}</label>
          <textarea 
            id="field-message" 
            name="message" 
            class="form-input form-textarea" 
            placeholder={t.contact.fields.message} 
            rows="3"
          ></textarea>
        </div>

        <!-- Consent Box (not pre-ticked) -->
        <div class="consent-group">
          <input type="checkbox" id="field-consent" name="consent" class="consent-checkbox" required />
          <label for="field-consent" class="consent-label">
            {lang === 'fr' ? (
              <>J'accepte que Best of India utilise mes coordonnées pour répondre à ma demande. Voir la <a href={privacyLink} class="consent-link">politique de confidentialité</a>.</>
            ) : (
              <>I agree that Best of India may use my details to respond to my request. See the <a href={privacyLink} class="consent-link">privacy policy</a>.</>
            )}
          </label>
          <span class="error-msg" id="err-consent">{t.contact.validation.consentRequired}</span>
        </div>

        <!-- Form Status Message Banners -->
        <div id="form-success" class="form-status success-status" role="alert" style="display: none;">
          {t.contact.success}
        </div>
        <div id="form-error" class="form-status error-status" role="alert" style="display: none;">
          {t.contact.error}
        </div>

        <!-- Submit Button: 314 x 42px outline submit button, centred -->
        <div class="submit-wrapper">
          <button type="submit" id="submit-btn" class="btn-outline submit-btn">
            {t.contact.button}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  /* CONTACT: Background --panel, minimum height 409px, 77px space above and below. Two columns. */
  .contact-section {
    background-color: var(--panel);
    min-height: 409px;
    width: 100%;
    padding: 77px 45px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }

  .contact-container {
    max-width: 1200px;
    width: 100%;
    display: grid;
    grid-template-columns: 463px 353px;
    justify-content: space-between;
    align-items: flex-start;
  }

  /* Left Column: Heading left-aligned, body text 371px wide, 34px below */
  .contact-info-col {
    display: flex;
    flex-direction: column;
    max-width: 463px;
  }

  .contact-heading {
    font-family: var(--font-heading);
    font-size: 35px;
    line-height: 42px;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: var(--heading);
    font-weight: 400;
    margin: 0;
    text-align: left;
  }

  .contact-subtext {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 14px;
    line-height: 25.2px;
    color: var(--text);
    max-width: 371px;
    margin-top: 34px;
    margin-bottom: 30px;
  }

  .contact-details-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .contact-detail-row {
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 20px;
    color: var(--text);
  }

  .detail-label {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-right: 6px;
    color: var(--heading);
  }

  .detail-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .detail-link:hover {
    opacity: 0.8;
  }

  .detail-text {
    color: var(--text);
  }

  /* Right Column: 353px wide. Form fields with transparent background,
     no boxes and only a 1px rust bottom border.
     Placeholder text in rust Ubuntu uppercase, centred.
     Fields are 23px high with 40px between rules. Message field is 73px high. */
  .contact-form-col {
    width: 353px;
    max-width: 100%;
  }

  .catering-form {
    display: flex;
    flex-direction: column;
  }

  .form-group {
    position: relative;
    margin-bottom: 40px; /* 40px between rules */
  }

  .form-input {
    width: 100%;
    height: 23px; /* 23px high */
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--accent);
    border-radius: 0;
    color: var(--accent);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    text-align: center;
    box-sizing: border-box;
    padding: 0 4px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .form-input::placeholder {
    color: var(--accent);
    opacity: 0.85;
    text-transform: uppercase;
    text-align: center;
    font-family: var(--font-ui);
    letter-spacing: 1.2px;
    font-size: 13px;
  }

  .form-input:focus {
    border-bottom: 2px solid var(--accent);
  }

  .form-select {
    cursor: pointer;
    text-align-last: center;
    appearance: none;
    -webkit-appearance: none;
  }

  .form-select option {
    background-color: var(--panel);
    color: var(--heading);
    text-transform: none;
    font-family: var(--font-body);
  }

  .form-textarea {
    height: 73px; /* 73px high */
    resize: vertical;
    text-align: center;
    padding: 4px;
  }

  .message-group {
    margin-bottom: 28px;
  }

  /* Consent group */
  .consent-group {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 32px;
    position: relative;
  }

  .consent-checkbox {
    margin-top: 3px;
    accent-color: var(--accent);
    cursor: pointer;
    flex-shrink: 0;
  }

  .consent-label {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 18px;
    color: var(--text);
    cursor: pointer;
  }

  .consent-link {
    color: var(--accent);
    text-decoration: underline;
  }

  .error-msg {
    display: none;
    font-family: var(--font-ui);
    font-size: 11px;
    color: #C00;
    margin-top: 4px;
    text-align: center;
  }

  .form-status {
    padding: 12px;
    margin-bottom: 20px;
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 18px;
    text-align: center;
  }

  .success-status {
    background-color: #E2F0D9;
    color: #2E5A1C;
    border: 1px solid #C1E1B0;
  }

  .error-status {
    background-color: #FCE8E6;
    color: #A51D1D;
    border: 1px solid #F5C6CB;
  }

  /* Centred Submit Button */
  .submit-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .submit-btn {
    width: 314px;
  }

  /* Mobile Layout (< 768px):
     Heading centred, text, details, then the form with centred placeholders and a full-width outline button. */
  @media (max-width: 767px) {
    .contact-section {
      padding: 54px 20px;
    }
    .contact-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .contact-info-col {
      max-width: 100%;
      text-align: center;
      align-items: center;
    }
    .contact-heading {
      text-align: center;
      font-size: 26px;
      line-height: 32px;
      letter-spacing: 2px;
    }
    .contact-subtext {
      max-width: 100%;
      text-align: center;
      margin-top: 20px;
    }
    .contact-details-list {
      align-items: center;
      text-align: center;
    }
    .contact-form-col {
      width: 100%;
    }
    .submit-btn {
      width: 100%;
    }
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('catering-contact-form') as HTMLFormElement | null;
    if (!form) return;

    // Grab URL query params for UTM and GCLID tracking
    const urlParams = new URLSearchParams(window.location.search);
    const utmSource = urlParams.get('utm_source') || '';
    const utmMedium = urlParams.get('utm_medium') || '';
    const utmCampaign = urlParams.get('utm_campaign') || '';
    const gclid = urlParams.get('gclid') || '';

    (document.getElementById('utm_source') as HTMLInputElement).value = utmSource;
    (document.getElementById('utm_medium') as HTMLInputElement).value = utmMedium;
    (document.getElementById('utm_campaign') as HTMLInputElement).value = utmCampaign;
    (document.getElementById('gclid') as HTMLInputElement).value = gclid;

    const successEl = document.getElementById('form-success');
    const errorEl = document.getElementById('form-error');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous error messages
      const errorSpans = form.querySelectorAll<HTMLElement>('.error-msg');
      errorSpans.forEach(el => el.style.display = 'none');
      if (successEl) successEl.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';

      // Honeypot check
      const honeypot = (form.querySelector('input[name="company_extra"]') as HTMLInputElement)?.value;
      if (honeypot) {
        // Silently drop spam bot
        if (successEl) successEl.style.display = 'block';
        return;
      }

      // Inline validation
      let isValid = true;
      const nameInput = form.querySelector('#field-name') as HTMLInputElement;
      const phoneInput = form.querySelector('#field-phone') as HTMLInputElement;
      const emailInput = form.querySelector('#field-email') as HTMLInputElement;
      const eventTypeSelect = form.querySelector('#event-type-select') as HTMLSelectElement;
      const guestsSelect = form.querySelector('#field-guests') as HTMLSelectElement;
      const consentBox = form.querySelector('#field-consent') as HTMLInputElement;

      if (!nameInput.value.trim()) {
        const err = document.getElementById('err-name');
        if (err) err.style.display = 'block';
        isValid = false;
      }

      if (!phoneInput.value.trim()) {
        const err = document.getElementById('err-phone');
        if (err) err.style.display = 'block';
        isValid = false;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailInput.value.trim() || !emailRegex.test(emailInput.value.trim())) {
        const err = document.getElementById('err-email');
        if (err) err.style.display = 'block';
        isValid = false;
      }

      if (!eventTypeSelect.value) {
        const err = document.getElementById('err-event-type');
        if (err) err.style.display = 'block';
        isValid = false;
      }

      if (!guestsSelect.value) {
        const err = document.getElementById('err-guests');
        if (err) err.style.display = 'block';
        isValid = false;
      }

      if (!consentBox.checked) {
        const err = document.getElementById('err-consent');
        if (err) err.style.display = 'block';
        isValid = false;
      }

      if (!isValid) return;

      const submitBtn = form.querySelector('#submit-btn') as HTMLButtonElement;
      const originalBtnText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = '...';

      // Record chosen tile
      (document.getElementById('hidden-chosen-tile') as HTMLInputElement).value = eventTypeSelect.value;

      try {
        const formData = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (res.ok) {
          if (successEl) successEl.style.display = 'block';
          form.reset();
          // dataLayer event
          try {
            (window as any).dataLayer = (window as any).dataLayer || [];
            (window as any).dataLayer.push({
              event: 'generate_lead',
              event_type: eventTypeSelect.value,
              guests: guestsSelect.value
            });
          } catch (_) {}
        } else {
          // Keep entered data and show error
          if (errorEl) errorEl.style.display = 'block';
        }
      } catch (err) {
        // Keep entered data on network failure
        if (errorEl) errorEl.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
