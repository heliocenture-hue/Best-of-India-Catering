---
import { getTranslations, type Language } from '../i18n/utils';
import { CONFIG } from '../config';
import Phone from 'lucide-astro/Phone';
import Mail from 'lucide-astro/Mail';
import MessageCircle from 'lucide-astro/MessageCircle';
import MapPin from 'lucide-astro/MapPin';
import Clock from 'lucide-astro/Clock';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const privacyLink = lang === 'fr' ? '/politique-confidentialite/' : '/en/privacy-policy/';
const whatsappUrl = `https://wa.me/${CONFIG.WHATSAPP_NUMBER}?text=${encodeURIComponent(t.floating.whatsappMessage)}`;
---

<section id="contact" class="contact-section" aria-label="Contact Best of India">
  <div class="contact-container">
    <!-- Left Column: one continuous stack (heading, 12px gap, paragraph, 24px gap, contact details) -->
    <div class="contact-left-col">
      <div class="contact-header-block">
        <h2 class="contact-title">{t.contact.heading}</h2>
        <p class="contact-desc">{t.contact.text}</p>
      </div>

      <!-- Contact details list: Phone, Email, WhatsApp, Address, Restaurant hours -->
      <div class="contact-details-list">
        <!-- Phone -->
        <div class="contact-row">
          <div class="contact-row-icon">
            <Phone size={18} class="saffron-icon" />
          </div>
          <div class="contact-row-content">
            <span class="row-label">{t.contact.phoneLabel}</span>
            <a href={`tel:${CONFIG.PHONE_LINK}`} class="row-value row-link">{CONFIG.PHONE_DISPLAY}</a>
          </div>
        </div>

        <!-- Email -->
        <div class="contact-row">
          <div class="contact-row-icon">
            <Mail size={18} class="saffron-icon" />
          </div>
          <div class="contact-row-content">
            <span class="row-label">{t.contact.emailLabel}</span>
            <a href={`mailto:${CONFIG.EMAIL}`} class="row-value row-link">{CONFIG.EMAIL}</a>
          </div>
        </div>

        <!-- WhatsApp -->
        <div class="contact-row">
          <div class="contact-row-icon">
            <MessageCircle size={18} class="saffron-icon" />
          </div>
          <div class="contact-row-content">
            <span class="row-label">{t.contact.whatsappLabel || 'WhatsApp'}</span>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="row-value row-link whatsapp-text-link">
              {t.contact.chatOnWhatsapp}
            </a>
          </div>
        </div>

        <!-- Address -->
        <div class="contact-row">
          <div class="contact-row-icon">
            <MapPin size={18} class="saffron-icon" />
          </div>
          <div class="contact-row-content">
            <span class="row-label">{t.contact.addressLabel}</span>
            <span class="row-value">{CONFIG.ADDRESS}</span>
          </div>
        </div>

        <!-- Hours -->
        <div class="contact-row">
          <div class="contact-row-icon">
            <Clock size={18} class="saffron-icon" />
          </div>
          <div class="contact-row-content">
            <span class="row-label">{t.contact.hoursLabel}</span>
            <span class="row-value">{lang === 'fr' ? CONFIG.HOURS_FR : CONFIG.HOURS_EN}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Form Card -->
    <div class="contact-right-col">
      <div class="quote-card">
        <!-- Rust #984421 Header Band -->
        <div class="card-header-band">
          <h3 class="band-title">{t.contact.cardHeaderTitle}</h3>
          <span class="band-required">{t.contact.requiredLabel}</span>
        </div>

        <!-- Success Container (replaces card body on success) -->
        <div id="form-success-card" class="card-body success-body" style="display: none;">
          <div class="success-message-wrap">
            <div class="success-checkmark">✓</div>
            <h4 class="success-title">{lang === 'fr' ? 'Demande envoyée avec succès !' : 'Quote Request Sent!'}</h4>
            <p class="success-desc">{t.contact.success}</p>
          </div>
        </div>

        <!-- Form Card Body -->
        <div id="form-body-wrapper" class="card-body">
          <form 
            id="catering-contact-form" 
            class="catering-form" 
            action={CONFIG.FORM_ENDPOINT} 
            method="POST" 
            novalidate
          >
            <!-- Hidden Tracking & Anti-Spam Fields -->
            <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
            <input type="hidden" name="language" value={lang} />
            <input type="hidden" name="chosen_tile" id="hidden-chosen-tile" value="" />
            <input type="hidden" name="utm_source" id="utm_source" value="" />
            <input type="hidden" name="utm_medium" id="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" id="utm_campaign" value="" />
            <input type="hidden" name="gclid" id="gclid" value="" />

            <!-- Honeypot -->
            <div class="hp-field" style="display:none !important;" aria-hidden="true">
              <label for="company_extra">Do not fill this</label>
              <input type="text" name="company_extra" id="company_extra" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Single Form Grid: 2 equal columns, 16px col gap, 12px row gap -->
            <div class="form-grid">
              <!-- Row 1: Name* | Phone* -->
              <div class="field-item">
                <label for="field-name" class="field-label">{t.contact.fields.name}</label>
                <input 
                  type="text" 
                  id="field-name" 
                  name="name" 
                  class="field-input" 
                  required 
                />
                <span class="field-error" id="err-name">{t.contact.validation.nameRequired}</span>
              </div>

              <div class="field-item">
                <label for="field-phone" class="field-label">{t.contact.fields.phone}</label>
                <input 
                  type="tel" 
                  id="field-phone" 
                  name="phone" 
                  class="field-input" 
                  required 
                />
                <span class="field-error" id="err-phone">{t.contact.validation.phoneRequired}</span>
              </div>

              <!-- Row 2: Email* | Event Type* -->
              <div class="field-item">
                <label for="field-email" class="field-label">{t.contact.fields.email}</label>
                <input 
                  type="email" 
                  id="field-email" 
                  name="email" 
                  class="field-input" 
                  required 
                />
                <span class="field-error" id="err-email">{t.contact.validation.emailRequired}</span>
              </div>

              <div class="field-item">
                <label for="event-type-select" class="field-label">{t.contact.fields.eventType}</label>
                <div class="select-wrapper">
                  <select id="event-type-select" name="event_type" class="field-input field-select" required>
                    <option value="" disabled selected>{t.contact.selectEventPlaceholder}</option>
                    {t.occasions.items.map((occ) => (
                      <option value={occ.id}>{occ.title}</option>
                    ))}
                    <option value="other">{t.contact.otherEvent}</option>
                  </select>
                </div>
                <span class="field-error" id="err-event-type">{t.contact.validation.eventTypeRequired}</span>
              </div>

              <!-- Row 3: Event Date | Number of Guests* -->
              <div class="field-item">
                <label for="field-date" class="field-label">{t.contact.fields.eventDate}</label>
                <input 
                  type="date" 
                  id="field-date" 
                  name="event_date" 
                  class="field-input field-date" 
                />
              </div>

              <div class="field-item">
                <label for="field-guests" class="field-label">{t.contact.fields.guests}</label>
                <div class="select-wrapper">
                  <select id="field-guests" name="guests_count" class="field-input field-select" required>
                    <option value="" disabled selected>{t.contact.selectGuestsPlaceholder}</option>
                    {t.contact.guestOptions.map((opt) => (
                      <option value={opt}>{opt}</option>
                    ))}
                  </select>
                </div>
                <span class="field-error" id="err-guests">{t.contact.validation.guestsRequired}</span>
              </div>

              <!-- Row 4: Message (full width) -->
              <div class="field-item col-span-full">
                <label for="field-message" class="field-label">{t.contact.fields.message}</label>
                <textarea 
                  id="field-message" 
                  name="message" 
                  class="field-input field-textarea" 
                  placeholder={t.contact.messagePlaceholder} 
                  rows="2"
                ></textarea>
              </div>

              <!-- Row 5: Consent checkbox and text (full width) -->
              <div class="field-item col-span-full consent-wrapper">
                <div class="consent-block">
                  <input type="checkbox" id="field-consent" name="consent" class="consent-box" required />
                  <label for="field-consent" class="consent-text">
                    {lang === 'fr' ? (
                      <>J'accepte que Best of India utilise mes coordonnées pour répondre à ma demande. Voir la <a href={privacyLink} class="consent-anchor">politique de confidentialité</a>.</>
                    ) : (
                      <>I agree that Best of India may use my details to respond to my request. See the <a href={privacyLink} class="consent-anchor">privacy policy</a>.</>
                    )}
                  </label>
                </div>
                <span class="field-error consent-error" id="err-consent">{t.contact.validation.consentRequired}</span>
              </div>

              <!-- Error Banner (shown only on server failure) -->
              <div id="form-error" class="form-error-banner col-span-full" role="alert" style="display: none;">
                {t.contact.error}
              </div>

              <!-- Row 6: Submit button (full width, 48px high) -->
              <div class="col-span-full submit-wrapper">
                <button type="submit" id="submit-btn" class="submit-btn">
                  {t.contact.submitButton}
                </button>
              </div>

              <!-- Row 7: Reassurance line (full width, centred, 12px, 8px above) -->
              <div class="col-span-full reassurance-wrapper">
                <p class="no-commitment-note">{t.contact.noCommitment}</p>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* SECTION: Background deep brown #2B1409. 56px top/bottom desktop. Container max 1120px, centred. */
  .contact-section {
    background-color: #2B1409;
    width: 100%;
    padding: 56px 0;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }

  /* 1024px AND UP: Left 38%, Right 62%, 48px gap, align-items: center */
  .contact-container {
    max-width: 1120px;
    width: 100%;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: calc((100% - 48px) * 0.38) calc((100% - 48px) * 0.62);
    gap: 48px;
    align-items: center;
    box-sizing: border-box;
  }

  /* LEFT COLUMN: One continuous stack: Heading -> 12px gap -> Paragraph -> 24px gap -> Contact details */
  .contact-left-col {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .contact-header-block {
    display: flex;
    flex-direction: column;
  }

  .contact-title {
    font-family: var(--font-heading);
    font-size: 34px;
    line-height: 1.2;
    letter-spacing: 1.5px;
    color: #FFFFFF;
    font-weight: 400;
    text-transform: uppercase;
    margin: 0 0 12px 0;
    text-align: left;
  }

  .contact-desc {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: #F7EFE3;
    margin: 0 0 24px 0;
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  /* CONTACT DETAILS LIST: Thin dividers between rows, 10px padding top/bottom */
  .contact-details-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    width: 100%;
  }

  .contact-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    box-sizing: border-box;
  }

  .contact-row-icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .saffron-icon {
    color: #F2A65A;
  }

  .contact-row-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .row-label {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #E8D9C5;
    line-height: 1.2;
  }

  .row-value {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.4;
    color: #FFFFFF;
    text-decoration: none;
    overflow-wrap: break-word;
  }

  .row-link:hover {
    text-decoration: underline;
  }

  .whatsapp-text-link {
    font-weight: 500;
    color: #F2A65A;
  }

  /* RIGHT COLUMN: FORM CARD (Target <= 600px total height at 1440x900) */
  .contact-right-col {
    width: 100%;
  }

  .quote-card {
    background-color: #FFFFFF;
    border-radius: 0;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    width: 100%;
  }

  /* HEADER BAND: padding 16px 28px, title 24px on one line, * Required aligned to the right */
  .card-header-band {
    background-color: #984421;
    padding: 16px 28px;
    color: #FFFFFF;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
  }

  .band-title {
    font-family: var(--font-heading);
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: 1px;
    color: #FFFFFF;
    font-weight: 400;
    margin: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .band-required {
    font-family: var(--font-body);
    font-size: 12px;
    color: #FFFFFF;
    opacity: 0.92;
    white-space: nowrap;
  }

  /* CARD BODY: padding 20px 28px 24px */
  .card-body {
    padding: 20px 28px 24px;
    position: relative;
    box-sizing: border-box;
  }

  /* SINGLE FORM GRID: 2 equal columns, 16px col gap, 12px row gap */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
    row-gap: 12px;
    width: 100%;
  }

  .field-item {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .col-span-full {
    grid-column: 1 / -1;
  }

  /* FIELD LABEL: 12px, Ubuntu 500, #2B1409, 4px beneath it */
  .field-label {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 12px;
    line-height: 1.2;
    color: #2B1409;
    margin-bottom: 4px;
    text-transform: none;
    display: block;
    white-space: nowrap;
  }

  /* INPUT & SELECT: 42px high, padding 0 12px, Montserrat 400, 14px on desktop */
  .field-input {
    width: 100%;
    height: 42px;
    line-height: 42px;
    background-color: #FBF8F3;
    border: 1px solid #BFAF9C;
    border-radius: 0;
    padding: 0 12px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    color: #19191A;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s ease, outline 0.2s ease, background-color 0.2s ease;
  }

  .field-input::placeholder {
    color: #6D6E71;
    opacity: 0.85;
  }

  .field-input:focus {
    background-color: #FFFFFF;
    border-color: #984421;
    outline: 2px solid #984421;
    outline-offset: -2px;
  }

  .field-input.has-error {
    border: 1px solid #B3261E !important;
  }

  /* ERROR MESSAGES: 12px, shown only on error, no space reserved when hidden */
  .field-error {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.2;
    color: #B3261E;
    margin-top: 3px;
    display: none;
  }

  /* SELECT: 42px high, padding right 32px, custom rust chevron */
  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .field-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    cursor: pointer;
    padding-right: 32px;
  }

  .select-wrapper::after {
    content: '';
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 5px;
    background-color: #984421;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    pointer-events: none;
  }

  /* DATE FIELD: 42px high, cursor pointer */
  .field-date {
    cursor: pointer;
  }

  /* MESSAGE TEXTAREA: 72px high, padding 8px 12px, resizable vertically only */
  .field-textarea {
    height: 72px;
    min-height: 72px;
    line-height: 1.4;
    padding: 8px 12px;
    resize: vertical;
  }

  /* CONSENT: 16px checkbox, 12px text, line-height 1.4 */
  .consent-wrapper {
    margin-top: 2px;
  }

  .consent-block {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .consent-box {
    width: 16px;
    height: 16px;
    accent-color: #984421;
    cursor: pointer;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .consent-text {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 12px;
    line-height: 1.4;
    color: #5A5A5A;
  }

  .consent-anchor {
    color: #984421;
    text-decoration: underline;
  }

  .consent-error {
    margin-top: 4px;
  }

  /* ERROR BANNER */
  .form-error-banner {
    background-color: #FDF2F2;
    border: 1px solid #B3261E;
    color: #B3261E;
    padding: 8px 12px;
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.3;
    margin: 4px 0;
    box-sizing: border-box;
  }

  /* SUBMIT BUTTON: 48px high, solid rust, white Ubuntu 500, hover #7A3518 */
  .submit-wrapper {
    width: 100%;
    margin-top: 2px;
  }

  .submit-btn {
    width: 100%;
    height: 48px;
    background-color: #984421;
    color: #FFFFFF;
    border: none;
    border-radius: 0;
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease;
    box-sizing: border-box;
  }

  .submit-btn:hover {
    background-color: #7A3518;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* REASSURANCE LINE: 12px, 8px above it, centred */
  .reassurance-wrapper {
    text-align: center;
    width: 100%;
  }

  .no-commitment-note {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.4;
    color: #5A5A5A;
    margin: 8px 0 0 0;
    text-align: center;
  }

  /* SUCCESS STATE (replaces card body) */
  .success-body {
    padding: 48px 28px;
    text-align: center;
  }

  .success-message-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .success-checkmark {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: #F6ECE0;
    color: #984421;
    font-size: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
  }

  .success-title {
    font-family: var(--font-heading);
    font-size: 24px;
    color: #2B1409;
    margin: 0;
    text-transform: uppercase;
  }

  .success-desc {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    color: #3D3D3D;
    max-width: 440px;
    margin: 0;
  }

  /* ==================================================
     TABLET: 768px to 1023px
     - Stack: heading and paragraph (1), form card (2), contact details (3)
     - Keep 2-column form grid
     - Contact details: 2 columns, without dividers
     ================================================== */
  @media (min-width: 768px) and (max-width: 1023px) {
    .contact-section {
      padding: 56px 0;
    }

    .contact-container {
      display: flex;
      flex-direction: column;
      padding: 0 32px;
      gap: 32px;
      max-width: 720px;
    }

    .contact-left-col {
      display: contents;
    }

    .contact-header-block {
      order: 1;
      width: 100%;
    }

    .contact-title {
      font-size: 32px;
    }

    .contact-desc {
      margin-bottom: 0;
    }

    .contact-right-col {
      order: 2;
      width: 100%;
    }

    .contact-details-list {
      order: 3;
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 24px;
      border: none;
      padding-top: 8px;
    }

    .contact-row {
      border: none;
      padding: 4px 0;
    }
  }

  /* ==================================================
     BELOW 768px: Mobile
     - Section padding: 40px top and bottom, 16px side margins (extra bottom padding to clear floating bottom bar)
     - Order: heading and paragraph, form card, contact details
     - Heading: 28px. Paragraph: 15px.
     - Header band: padding 14px 16px. Title: 21px. If title & "* Required" don't fit, "* Required" beneath title
     - Card body: padding 16px
     - Form grid: 1 column, 10px row gap
     - Inputs and dropdowns: 44px high with 16px text (prevents iOS zoom)
     - Message: 72px high
     ================================================== */
  @media (max-width: 767px) {
    .contact-section {
      padding: 40px 16px 88px;
    }

    .contact-container {
      display: flex;
      flex-direction: column;
      padding: 0;
      gap: 24px;
      width: 100%;
    }

    .contact-left-col {
      display: contents;
    }

    .contact-header-block {
      order: 1;
      width: 100%;
    }

    .contact-title {
      font-size: 28px;
      line-height: 1.2;
      margin-bottom: 8px;
    }

    .contact-desc {
      font-size: 15px;
      line-height: 1.6;
      margin-bottom: 0;
    }

    .contact-right-col {
      order: 2;
      width: 100%;
    }

    .card-header-band {
      padding: 14px 16px;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .band-title {
      font-size: 21px;
      white-space: normal;
    }

    .band-required {
      font-size: 12px;
    }

    .card-body {
      padding: 16px;
    }

    .form-grid {
      grid-template-columns: 1fr;
      row-gap: 10px;
      column-gap: 0;
    }

    .col-span-full {
      grid-column: auto;
    }

    .field-label {
      font-size: 12px;
      margin-bottom: 4px;
      white-space: normal;
    }

    .field-input {
      height: 44px;
      line-height: 44px;
      font-size: 16px;
      padding: 0 12px;
    }

    .field-select {
      padding-right: 32px;
    }

    .field-textarea {
      height: 72px;
      min-height: 72px;
      font-size: 16px;
      line-height: 1.4;
      padding: 8px 12px;
    }

    .contact-details-list {
      order: 3;
      width: 100%;
      margin-top: 8px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .contact-row {
      padding: 10px 0;
    }
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('catering-contact-form') as HTMLFormElement | null;
    if (!form) return;

    // Set minimum date to today (past dates disabled)
    const dateInput = document.getElementById('field-date') as HTMLInputElement | null;
    if (dateInput) {
      const today = new Date().toISOString().split('T')[0];
      dateInput.min = today;
    }

    // Grab URL query params for UTM and GCLID tracking
    const urlParams = new URLSearchParams(window.location.search);
    const utmSource = urlParams.get('utm_source') || '';
    const utmMedium = urlParams.get('utm_medium') || '';
    const utmCampaign = urlParams.get('utm_campaign') || '';
    const gclid = urlParams.get('gclid') || '';

    const utmSourceEl = document.getElementById('utm_source') as HTMLInputElement | null;
    const utmMediumEl = document.getElementById('utm_medium') as HTMLInputElement | null;
    const utmCampaignEl = document.getElementById('utm_campaign') as HTMLInputElement | null;
    const gclidEl = document.getElementById('gclid') as HTMLInputElement | null;

    if (utmSourceEl) utmSourceEl.value = utmSource;
    if (utmMediumEl) utmMediumEl.value = utmMedium;
    if (utmCampaignEl) utmCampaignEl.value = utmCampaign;
    if (gclidEl) gclidEl.value = gclid;

    const formBodyWrapper = document.getElementById('form-body-wrapper');
    const successCard = document.getElementById('form-success-card');
    const errorEl = document.getElementById('form-error');

    // Hide fixed mobile bottom bar while any form input/textarea has focus
    const mobileBottomBar = document.querySelector('.mobile-bottom-bar') as HTMLElement | null;
    const inputsAndSelects = form.querySelectorAll<HTMLElement>('input, select, textarea');
    inputsAndSelects.forEach((el) => {
      el.addEventListener('focus', () => {
        if (mobileBottomBar) {
          mobileBottomBar.style.display = 'none';
        }
      });
      el.addEventListener('blur', () => {
        if (mobileBottomBar) {
          mobileBottomBar.style.display = '';
        }
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous error messages & highlights
      const errorSpans = form.querySelectorAll<HTMLElement>('.field-error');
      errorSpans.forEach((el) => (el.style.display = 'none'));
      const inputs = form.querySelectorAll<HTMLElement>('.field-input');
      inputs.forEach((el) => el.classList.remove('has-error'));
      if (errorEl) errorEl.style.display = 'none';

      // Honeypot check
      const honeypot = (form.querySelector('input[name="company_extra"]') as HTMLInputElement)?.value;
      if (honeypot) {
        if (formBodyWrapper && successCard) {
          formBodyWrapper.style.display = 'none';
          successCard.style.display = 'block';
        }
        return;
      }

      // Inline validation
      let isValid = true;
      const nameInput = form.querySelector('#field-name') as HTMLInputElement;
      const phoneInput = form.querySelector('#field-phone') as HTMLInputElement;
      const emailInput = form.querySelector('#field-email') as HTMLInputElement;
      const eventTypeSelect = form.querySelector('#event-type-select') as HTMLSelectElement;
      const guestsSelect = form.querySelector('#field-guests') as HTMLSelectElement;
      const consentBox = form.querySelector('#field-consent') as HTMLInputElement;

      if (!nameInput.value.trim()) {
        const err = document.getElementById('err-name');
        if (err) err.style.display = 'block';
        nameInput.classList.add('has-error');
        isValid = false;
      }

      if (!phoneInput.value.trim()) {
        const err = document.getElementById('err-phone');
        if (err) err.style.display = 'block';
        phoneInput.classList.add('has-error');
        isValid = false;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailInput.value.trim() || !emailRegex.test(emailInput.value.trim())) {
        const err = document.getElementById('err-email');
        if (err) err.style.display = 'block';
        emailInput.classList.add('has-error');
        isValid = false;
      }

      if (!eventTypeSelect.value) {
        const err = document.getElementById('err-event-type');
        if (err) err.style.display = 'block';
        eventTypeSelect.classList.add('has-error');
        isValid = false;
      }

      if (!guestsSelect.value) {
        const err = document.getElementById('err-guests');
        if (err) err.style.display = 'block';
        guestsSelect.classList.add('has-error');
        isValid = false;
      }

      if (!consentBox.checked) {
        const err = document.getElementById('err-consent');
        if (err) err.style.display = 'block';
        isValid = false;
      }

      if (!isValid) return;

      const submitBtn = form.querySelector('#submit-btn') as HTMLButtonElement;
      const originalBtnText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = '...';

      // Record chosen tile
      const hiddenTile = document.getElementById('hidden-chosen-tile') as HTMLInputElement | null;
      if (hiddenTile) {
        hiddenTile.value = eventTypeSelect.value;
      }

      try {
        const formData = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json'
          }
        });

        if (res.ok) {
          // Success state replaces the card body but keeps the rust header band
          if (formBodyWrapper && successCard) {
            formBodyWrapper.style.display = 'none';
            successCard.style.display = 'block';
          }
          form.reset();

          // Trigger analytics dataLayer event
          try {
            (window as any).dataLayer = (window as any).dataLayer || [];
            (window as any).dataLayer.push({
              event: 'generate_lead',
              event_type: eventTypeSelect.value,
              guests: guestsSelect.value
            });
          } catch (_) {}
        } else {
          if (errorEl) errorEl.style.display = 'block';
        }
      } catch (err) {
        if (errorEl) errorEl.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
