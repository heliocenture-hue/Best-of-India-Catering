---
import { CONFIG } from '../config';
import type { Language } from '../i18n/utils';
import { getTranslations } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import '../styles/global.css';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const canonicalUrl = lang === 'en'
  ? 'https://traiteur.bestofindiaparis.com/en/'
  : 'https://traiteur.bestofindiaparis.com/';

const frUrl = 'https://traiteur.bestofindiaparis.com/';
const enUrl = 'https://traiteur.bestofindiaparis.com/en/';

// Schema JSON-LD FoodEstablishment with NO reviews or ratings
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["FoodEstablishment", "Restaurant"],
  "name": CONFIG.BRAND,
  "description": t.seo.description,
  "url": canonicalUrl,
  "telephone": CONFIG.PHONE_LINK,
  "email": CONFIG.EMAIL,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "170 Rue du Faubourg Saint-Denis",
    "addressLocality": "Paris",
    "postalCode": "75010",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 48.8778,
    "longitude": 2.3578
  },
  "servesCuisine": ["Indian", "South Indian", "Chettinad"],
  "openingHours": "Mo-Su 11:30-23:00",
  "sameAs": [CONFIG.INSTAGRAM, CONFIG.FACEBOOK, CONFIG.WEBSITE],
  "image": "https://traiteur.bestofindiaparis.com/assets/images/boi/hero-1.webp"
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.seo.title}</title>
    <meta name="description" content={t.seo.description} />

    <!-- Canonical & Hreflang Tags -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/assets/boi-logo.png" />
    <link rel="apple-touch-icon" href="/assets/boi-logo.png" />

    <!-- Preload Critical Self-Hosted Fonts -->
    <link
      rel="preload"
      href="/assets/fonts/Athelas-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/v6-IGZDIOVXH9xtmTZfRagunqBw5WC62QKknL-mYF20.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCs16Hw5aXp-p7K4KLg.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/4iCv6KVjbNBYlgoCjC3jsGyNPYZvgw.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Preload First Hero Image -->
    <link
      rel="preload"
      href="/assets/images/boi/hero-1.webp"
      as="image"
      type="image/webp"
    />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.seo.title} />
    <meta property="og:description" content={t.seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://traiteur.bestofindiaparis.com/assets/images/boi/hero-1.webp" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:site_name" content={CONFIG.BRAND} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.seo.title} />
    <meta name="twitter:description" content={t.seo.description} />
    <meta name="twitter:image" content="https://traiteur.bestofindiaparis.com/assets/images/boi/hero-1.webp" />

    <!-- JSON-LD Structured Data (No ratings or fake reviews) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- dataLayer Initialization -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>

    <!-- Google Tag Manager (Loads only after user consent - commented slot)
    <script is:inline>
      function loadGTM(gtmId) {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      }
      // Example call after consent:
      // if (userConsented) { loadGTM('GTM-XXXXXXX'); }
    </script>
    -->
  </head>
  <body>
    <!-- 1. Header and menu panel -->
    <Header lang={lang} />

    <main id="main-content">
      <slot />
    </main>

    <!-- 12. Footer -->
    <Footer lang={lang} />

    <!-- Always Visible Floating Actions (Back to Top, WhatsApp, Quote) -->
    <FloatingActions lang={lang} />
  </body>
</html>
