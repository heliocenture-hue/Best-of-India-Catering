---
import Layout from '../../layouts/Layout.astro';
import { CONFIG } from '../../config';
---

<Layout lang="en">
  <section class="legal-page-section">
    <div class="legal-container">
      <a href="/en/" class="back-link">← Back to Home</a>
      <h1 class="legal-title">Privacy Policy</h1>

      <div class="legal-content">
        <h2>1. Data Collection and Processing</h2>
        <p>
          Best of India is committed to ensuring that the collection and processing of your personal data complies with the General Data Protection Regulation (GDPR) and applicable French data privacy laws.
        </p>
        <p>
          Personal information collected via the contact form (name, phone, email, event type, date, number of guests, message) is used exclusively for preparing custom catering quotes and communicating regarding your enquiry.
        </p>

        <h2>2. Data Controller</h2>
        <p>
          The data controller is {CONFIG.LEGAL_DETAILS.entityName}, located at {CONFIG.ADDRESS}.<br />
          Email: {CONFIG.EMAIL} | Phone: {CONFIG.PHONE_DISPLAY}
        </p>

        <h2>3. Third-Party Services and Google Maps Integration</h2>
        <p>
          This website includes an interactive map via <strong>Google Maps</strong> (operated by Google LLC) to help visitors locate our restaurant in Paris. The use of Google Maps may result in cookies being set by Google and your IP address being transmitted to Google's servers. For further information, please consult Google's Privacy Policy.
        </p>

        <h2>4. Your Rights</h2>
        <p>
          In accordance with data privacy regulations, you have the right to access, rectify, delete, or request portability of your personal data. You may exercise this right at any time by contacting {CONFIG.EMAIL}.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-page-section {
    padding: 120px 24px 100px;
    background-color: var(--white);
    min-height: 80vh;
  }
  .legal-container {
    max-width: 840px;
    margin: 0 auto;
  }
  .back-link {
    display: inline-block;
    color: var(--accent);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 24px;
    text-decoration: underline;
  }
  .legal-title {
    font-family: var(--font-heading);
    font-size: 35px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--heading);
    margin-bottom: 32px;
  }
  .legal-content h2 {
    font-family: var(--font-heading);
    font-size: 22px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .legal-content p {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 15px;
    line-height: 26px;
    color: var(--text);
    margin-bottom: 14px;
  }
</style>
