---
import Layout from '../../layouts/Layout.astro';
import { CONFIG } from '../../config';
---

<Layout lang="en">
  <section class="legal-page-section">
    <div class="container legal-container">
      <a href="/en/" class="back-link">← Back to Home</a>
      <h1 class="legal-title">Privacy Policy</h1>

      <div class="legal-content">
        <h2>1. Collection of Personal Data</h2>
        <p>
          When using our catering enquiry form, <strong>Best of India</strong> collects the following information: full name, phone number, email address, event date, event type, guest count, location, dietary preferences, and optional message details.
        </p>

        <h2>2. Purpose of Processing</h2>
        <p>
          This information is gathered solely to process your catering request, build a tailored quotation, and coordinate your celebration. Your contact details are never sold, rented, or distributed to third parties for marketing purposes.
        </p>

        <h2>3. Data Retention</h2>
        <p>
          Enquiry records are retained only for the duration necessary to manage the commercial relationship and event delivery.
        </p>

        <h2>4. Your Rights (GDPR)</h2>
        <p>
          Under the General Data Protection Regulation (GDPR), you hold the right to access, rectify, or request deletion of your personal data. To exercise this right, please contact: <a href={`mailto:${CONFIG.EMAIL}`}>{CONFIG.EMAIL}</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-page-section {
    padding: 80px 0 100px;
    background-color: var(--color-white);
  }
  .legal-container {
    max-width: 800px;
  }
  .back-link {
    display: inline-block;
    color: var(--color-dark-orange);
    font-weight: 700;
    margin-bottom: 24px;
  }
  .legal-title {
    font-family: var(--font-heading);
    font-size: 42px;
    color: var(--color-deep-brown);
    margin-bottom: 32px;
  }
  .legal-content h2 {
    font-family: var(--font-heading);
    font-size: 24px;
    color: var(--color-deep-brown);
    margin: 28px 0 12px;
  }
  .legal-content p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-grey);
    margin-bottom: 16px;
  }
</style>
