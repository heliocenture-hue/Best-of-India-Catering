---
import Layout from '../../layouts/Layout.astro';
import { CONFIG } from '../../config';
---

<Layout lang="en">
  <section class="legal-page-section">
    <div class="legal-container">
      <a href="/en/" class="back-link">← Back to Home</a>
      <h1 class="legal-title">Legal Notice</h1>

      <div class="legal-content">
        <h2>1. Site Presentation</h2>
        <p>
          In accordance with French law n° 2004-575 of June 21, 2004 regarding trust in the digital economy, the identity of the stakeholders involved in the creation and monitoring of this site is specified:
        </p>
        <ul>
          <li><strong>Owner / Legal Entity:</strong> {CONFIG.LEGAL_DETAILS.entityName}</li>
          <li><strong>SIRET Number:</strong> {CONFIG.LEGAL_DETAILS.siret} <!-- TODO: [CONFIRM: SIRET Number] --></li>
          <li><strong>Address:</strong> {CONFIG.ADDRESS}</li>
          <li><strong>Publication Director:</strong> {CONFIG.LEGAL_DETAILS.director}</li>
          <li><strong>Phone:</strong> {CONFIG.PHONE_DISPLAY}</li>
          <li><strong>Email:</strong> {CONFIG.EMAIL}</li>
        </ul>

        <h2>2. Hosting</h2>
        <p>
          This website is hosted by: <strong>{CONFIG.LEGAL_DETAILS.host}</strong><br />
          Address: {CONFIG.LEGAL_DETAILS.hostAddress}
        </p>

        <h2>3. Intellectual Property</h2>
        <p>
          All content on this website is governed by French and international legislation on copyright and intellectual property. All reproduction rights are reserved for trademarks, photographs, and text.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-page-section {
    padding: 120px 24px 100px;
    background-color: var(--white);
    min-height: 80vh;
  }
  .legal-container {
    max-width: 840px;
    margin: 0 auto;
  }
  .back-link {
    display: inline-block;
    color: var(--accent);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 24px;
    text-decoration: underline;
  }
  .legal-title {
    font-family: var(--font-heading);
    font-size: 35px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--heading);
    margin-bottom: 32px;
  }
  .legal-content h2 {
    font-family: var(--font-heading);
    font-size: 22px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .legal-content p, .legal-content li {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 15px;
    line-height: 26px;
    color: var(--text);
  }
  .legal-content ul {
    margin-left: 20px;
    margin-top: 10px;
  }
</style>
