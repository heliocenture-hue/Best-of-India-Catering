---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TitleCardIntro from '../components/TitleCardIntro.astro';
import Intro from '../components/Intro.astro';
import Occasions from '../components/Occasions.astro';
import Testimonials from '../components/Testimonials.astro';
import Gallery from '../components/Gallery.astro';
import Menu from '../components/Menu.astro';
import WhyUs from '../components/WhyUs.astro';
import Contact from '../components/Contact.astro';
import Map from '../components/Map.astro';
---

<Layout lang="fr">
  <!-- 2. Hero slider (Ruby's hero) -->
  <Hero lang="fr" />

  <!-- 3. Title card, intro and numbers (id="top", Ruby's home-intro) -->
  <TitleCardIntro lang="fr" />

  <!-- 4. Who we are (id="about", Ruby's "Our Food") -->
  <Intro lang="fr" />

  <!-- 5. Who we serve (id="occasions", Ruby's "Our Venues" tiles) -->
  <Occasions lang="fr" />

  <!-- 6. Reviews (id="reviews", Ruby's reviews) -->
  <Testimonials lang="fr" />

  <!-- 7. Photo gallery slider (Ruby's gallery) -->
  <Gallery lang="fr" />

  <!-- 8. Sample menu (id="menu", Ruby's "Latest Posts" cards) -->
  <Menu lang="fr" />

  <!-- 9. Why choose us (id="why", BOI addition) -->
  <WhyUs lang="fr" />

  <!-- 10. Contact form (id="contact", Ruby's contact) -->
  <Contact lang="fr" />

  <!-- 11. Map (BOI addition) -->
  <Map lang="fr" />
</Layout>
