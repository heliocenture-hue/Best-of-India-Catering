---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Intro from '../components/Intro.astro';
import Occasions from '../components/Occasions.astro';
import Testimonials from '../components/Testimonials.astro';
import Menu from '../components/Menu.astro';
import WhyUs from '../components/WhyUs.astro';
import Contact from '../components/Contact.astro';
---

<Layout lang="fr">
  <!-- 2. Hero Section -->
  <Hero lang="fr" />

  <!-- 3. Authority numbers strip -->
  <Stats lang="fr" />

  <!-- 4. Who we are (id="about") -->
  <Intro lang="fr" />

  <!-- 5. Who we serve (id="occasions") -->
  <Occasions lang="fr" />

  <!-- 6. Testimonials (id="reviews") -->
  <Testimonials lang="fr" />

  <!-- 7. Sample menu (id="menu") -->
  <Menu lang="fr" />

  <!-- 8. Why choose us (id="why") -->
  <WhyUs lang="fr" />

  <!-- 9. Contact form, map and contact details (id="contact") -->
  <Contact lang="fr" />
</Layout>
